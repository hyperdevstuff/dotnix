#!/bin/sh
# clipmenu — searchable cliphist picker.
#
# Runs inside a floating kitty window (see the Mod+V bind in niri/config.kdl),
# because fzf can wrap text and show a full preview, which fuzzel's dmenu mode
# cannot. Fuzzel stays the app launcher; this is only the clipboard UI.

set -eu

command -v cliphist >/dev/null 2>&1 || exit 0
command -v fzf >/dev/null 2>&1 || exit 1

selection=$(
    cliphist list |
        fzf \
            --delimiter='\t' \
            --with-nth=2.. \
            --accept-nth=1 \
            --no-sort \
            --exact \
            --no-multi \
            --height=100% \
            --layout=reverse \
            --border=rounded \
            --border-label=' clipboard ' \
            --prompt='> ' \
            --info=inline \
            --color=16 \
            --preview="$HOME/.local/bin/clipmenu-preview {1}" \
            --preview-window='right:60%:wrap' \
            --bind='ctrl-d:execute-silent(printf "%s\n" {1} | cliphist delete)+reload(cliphist list)'
) || exit 0

[ -n "$selection" ] || exit 0
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cliphist decode "$selection" >"$tmp"
wl-copy <"$tmp"
