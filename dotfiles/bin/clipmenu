#!/bin/sh
# clipmenu — searchable cliphist picker.
#
# Opens native Quickshell history first, with a terminal picker for recovery.

set -eu

if command -v quickshell >/dev/null 2>&1 && quickshell ipc -c notchD call notchD openClipboard >/dev/null 2>&1; then
    exit 0
fi

command -v cliphist >/dev/null 2>&1 || exit 0
command -v fzf >/dev/null 2>&1 || exit 1

if [ ! -t 0 ]; then
    exec kitty --single-instance --class clipmenu -o initial_window_width=960 -o initial_window_height=640 -e "$0"
fi

selection=$(
    cliphist list |
        fzf \
            --delimiter='\t' \
            --with-nth=2.. \
            --accept-nth=1 \
            --no-sort \
            --exact \
            --no-multi \
            --height=100% \
            --layout=reverse \
            --border=rounded \
            --border-label=' clipboard ' \
            --prompt='> ' \
            --info=inline \
            --color=16 \
            --preview="$HOME/.local/bin/clipmenu-preview {1}" \
            --preview-window='right:60%:wrap' \
            --bind='ctrl-d:execute-silent(printf "%s\n" {1} | cliphist delete)+reload(cliphist list)'
) || exit 0

[ -n "$selection" ] || exit 0
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cliphist decode "$selection" >"$tmp"
wl-copy <"$tmp"
