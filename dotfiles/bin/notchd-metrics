#!/usr/bin/env python3
"""One bounded, read-only performance snapshot. No daemon or elevated access."""
import csv
import json
import shutil
import subprocess
import time
from pathlib import Path


def read(path):
    try:
        return Path(path).read_text().strip()
    except (OSError, UnicodeError):
        return ""


def temperature():
    for hw in sorted(Path('/sys/class/hwmon').glob('hwmon*')):
        if read(hw / 'name') not in ('coretemp', 'k10temp', 'zenpower'):
            continue
        values = []
        for sensor in hw.glob('temp*_input'):
            try:
                value = float(read(sensor)) / 1000
                if 0 < value < 150:
                    values.append(value)
            except ValueError:
                pass
        if values:
            return max(values)
    return None


def gpu_snapshot():
    # Reading runtime_status does not wake a discrete GPU. Do not query a
    # suspended NVIDIA device: nvidia-smi itself would wake it.
    for info in sorted(Path('/proc/driver/nvidia/gpus').glob('*/information')):
        props = dict(line.split(':', 1) for line in read(info).splitlines() if ':' in line)
        name = props.get('Model', 'NVIDIA GPU').strip()
        bus = info.parent.name
        runtime = read(Path('/sys/bus/pci/devices') / bus / 'power/runtime_status')
        result = dict(name=name, usage=None, temperature=None, state='Unavailable')
        if runtime != 'active':
            result['state'] = 'Sleeping' if runtime == 'suspended' else 'Unavailable'
            return result
        if not shutil.which('nvidia-smi'):
            return result
        try:
            raw = subprocess.run(
                ['nvidia-smi', '-i', bus, '--query-gpu=utilization.gpu,temperature.gpu',
                 '--format=csv,noheader,nounits'], capture_output=True, text=True,
                timeout=0.8, check=True).stdout
            values = next(csv.reader(raw.splitlines()))
            result.update(usage=max(0, min(100, float(values[0]))),
                          temperature=float(values[1]), state='Active')
        except (OSError, ValueError, subprocess.SubprocessError, StopIteration, IndexError):
            pass
        return result
    for device in sorted(Path('/sys/class/drm').glob('card[0-9]*/device')):
        try:
            usage = float(read(device / 'gpu_busy_percent'))
        except ValueError:
            continue
        return dict(name='Graphics', usage=max(0, min(100, usage)), temperature=None, state='Active')
    return dict(name='Graphics', usage=None, temperature=None, state='Unavailable')


def snapshot():
    fields = [int(x) for x in read('/proc/stat').splitlines()[0].split()[1:9]]
    memory = {}
    for line in read('/proc/meminfo').splitlines():
        key, value = line.split(':', 1)
        memory[key] = int(value.split()[0]) * 1024
    total = memory['MemTotal']
    used = total - memory['MemAvailable']
    cpu_name = next((line.split(':', 1)[1].strip() for line in read('/proc/cpuinfo').splitlines()
                     if line.startswith('model name')), 'Processor')
    disk = shutil.disk_usage(Path.home())
    rx = tx = 0
    interfaces = []
    for line in read('/proc/net/dev').splitlines():
        if ':' not in line:
            continue
        name, values = line.split(':', 1)
        name = name.strip()
        # Physical interfaces only: avoid double-counting VPN/bridge traffic.
        if not (Path('/sys/class/net') / name / 'device').exists():
            continue
        v = values.split()
        rx += int(v[0])
        tx += int(v[8])
        interfaces.append(name)
    return dict(time=time.monotonic(), cpu=dict(name=cpu_name, total=sum(fields),
                idle=fields[3] + fields[4], temperature=temperature()),
                memory=dict(used=used, total=total),
                storage=dict(used=disk.total - disk.free, total=disk.total, free=disk.free),
                network=dict(rx=rx, tx=tx, interfaces=interfaces), gpu=gpu_snapshot(),
                uptime=float(read('/proc/uptime').split()[0]))


if __name__ == '__main__':
    try:
        print(json.dumps(snapshot(), allow_nan=False))
    except (OSError, ValueError, KeyError, IndexError) as error:
        print(json.dumps(dict(error=str(error))))
        raise SystemExit(1)
