#!/usr/bin/env bash
set -euo pipefail
umask 077
runtime_dir=${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/notchd}
mkdir -p "$runtime_dir"
exec 9>"$runtime_dir/notchd-screenshot.lock"
flock -n 9 || exit 0

# Close the island before selecting; no clipboard or saved file is changed
# until the user chooses an action in the annotation editor.
if command -v quickshell >/dev/null; then
  shell_status=$(quickshell ipc -c notchD call notchD status 2>/dev/null || true)
  if [[ -n "$shell_status" ]] && printf '%s' "$shell_status" | jq -e '.locked == true' >/dev/null 2>&1; then
    exit 1
  fi
  quickshell ipc -c notchD call notchD collapse >/dev/null 2>&1 || true
fi
if ! selection=$(slurp -d); then
  exit 0
fi
[[ "$selection" =~ ^-?[0-9]+,-?[0-9]+\ [1-9][0-9]*x[1-9][0-9]*$ ]] || exit 1
capture_dir=$(mktemp -d "$runtime_dir/notchd-screenshot.XXXXXX")
trap 'rm -rf "$capture_dir"' EXIT
grim -g "$selection" "$capture_dir/capture.png"
swappy -f "$capture_dir/capture.png"
