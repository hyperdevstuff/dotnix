#!/usr/bin/env bash
# warm-helium — pull Helium's binary and profile into the page cache after
# login. The Nix store and $HOME live on a 5400 rpm USB HDD here, so the first
# window otherwise spends ~12 s on random reads; with the cache warm it opens
# in well under a second. Runs at idle IO priority and is harmless if it races
# a real launch.
set -u

# Give the session (niri, quickshell, matugen) a head start.
sleep "${1:-15}"

helium="$(command -v helium 2>/dev/null || true)"
if [ -z "$helium" ] && [ -x "/etc/profiles/per-user/$USER/bin/helium" ]; then
  helium="/etc/profiles/per-user/$USER/bin/helium"
fi
helium="$(readlink -f "$helium" 2>/dev/null)" || exit 0
store="${helium%/bin/helium}"
bin="$store/opt/helium/helium"
[ -f "$bin" ] || exit 0

# ~300 MB binary + the resources next to it.
cat "$bin" >/dev/null
find "$store/opt/helium" -maxdepth 1 -type f -exec cat {} + >/dev/null 2>&1 || true

# Profile databases Chromium opens before the first window. The Service Worker
# cache is 300+ MB of mostly-lazy data, so skip it.
prof="${XDG_CONFIG_HOME:-$HOME/.config}/net.imput.helium"
if [ -d "$prof" ]; then
  find "$prof" \( -path "*/Default/Service Worker" -prune \) \
    -o -type f -exec cat {} + >/dev/null 2>&1 || true
fi

# Shared libraries (~7 MB, scattered across the store).
ldd "$bin" 2>/dev/null | awk '/=> \// { print $3 }' | xargs -r cat >/dev/null 2>&1 || true

exit 0
