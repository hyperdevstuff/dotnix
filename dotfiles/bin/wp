#!/usr/bin/env bash
# wp — set wallpaper and regenerate the desktop theme from it.
# Usage:
#   wp                    random wallpaper from ~/Pictures/walls (recursive)
#   wp random             same
#   wp gruvbox            random from walls/gruvbox  (warm, manga, sepia)
#   wp bw                 random from walls/bw       (black-and-white / e-ink)
#   wp manga              random from walls/manga    (manga panels)
#   wp fav                random from your favorites
#   wp fav add [path]     favorite a wallpaper (default: the current one)
#   wp fav rm [path]      unfavorite a wallpaper (default: the current one)
#   wp fav toggle [path]  toggle favorite (default: the current one)
#   wp fav list           list favorites
#   wp theme [mode]       global light/dark: auto (follow wallpaper) | light | dark
#   wp current            print the current wallpaper path, if any
#   wp refresh            regenerate the theme from the current wallpaper
#   wp <path>             explicit image
#
# Favorites live in ~/.config/wallpapers/favorites (one absolute path per line).
# Scheme mapping: walls/bw -> SchemeMonochrome (paper/e-ink), everything
# else -> SchemeTonalSpot (material default: keeps a usable, colorful accent
# instead of scheme-content's often-white primary/secondary).
# Mode defaults to auto (matugen "smart"): light wallpapers get light chrome,
# dark ones dark. `wp theme light|dark` forces it globally.
set -euo pipefail

WALLS="$HOME/Pictures/walls"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
FAVS="$CONFIG/wallpapers/favorites"
THEME_FILE="$CONFIG/wallpapers/theme"
GEN_DIR="$CONFIG/matugen/generated"

pick() {
  find "$1" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | shuf -n 1
}

current_wall() {
  awww query --json 2>/dev/null | jq -r 'first(.[][] | .displaying.image? // empty) // empty' || true
}

# Absolute, normalized path for a user-provided path (or the current wallpaper).
norm_path() {
  local p="${1:-}"
  [ -z "$p" ] && p="$(current_wall)"
  [ -z "$p" ] && return 1
  [[ "$p" != /* ]] && p="$PWD/$p"
  realpath -m -- "$p"
}

fav_list() {
  [ -f "$FAVS" ] || return 0
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && printf '%s\n' "$f"
  done < "$FAVS"
}

fav_has() {
  [ -f "$FAVS" ] && grep -qxF -- "$1" "$FAVS"
}

fav_add() {
  local p
  p="$(norm_path "${1:-}")" || { echo "wp: no current wallpaper" >&2; return 1; }
  [ -f "$p" ] || { echo "wp: no such file: $p" >&2; return 1; }
  mkdir -p "$(dirname "$FAVS")"
  touch "$FAVS"
  if fav_has "$p"; then
    echo "wp: already a favorite: $p"
  else
    printf '%s\n' "$p" >> "$FAVS"
    echo "wp: favorited: $p"
  fi
}

fav_rm() {
  local p tmp
  p="$(norm_path "${1:-}")" || { echo "wp: no current wallpaper" >&2; return 1; }
  [ -f "$FAVS" ] || { echo "wp: no favorites yet" >&2; return 1; }
  tmp="$(mktemp)"
  grep -vxF -- "$p" "$FAVS" > "$tmp" || true
  mv -- "$tmp" "$FAVS"
  echo "wp: unfavorited: $p"
}

fav_toggle() {
  local p
  p="$(norm_path "${1:-}")" || { echo "wp: no current wallpaper" >&2; return 1; }
  if fav_has "$p"; then
    fav_rm "$p"
  else
    fav_add "$p"
  fi
}

# Global light/dark preference: auto (follow wallpaper) | light | dark.
theme_mode() {
  local m
  m="$(cat "$THEME_FILE" 2>/dev/null || true)"
  case "$m" in
    light|dark) printf '%s\n' "$m" ;;
    *)          echo auto ;;
  esac
}

# matugen's name for "follow the wallpaper" is smart.
matugen_mode() {
  case "$(theme_mode)" in
    light|dark) theme_mode ;;
    *)          echo smart ;;
  esac
}

# Set a dconf-backed desktop setting without assuming gsettings is on PATH.
# niri's spawn environment and user systemd units carry the Nix profile but
# not /usr/bin, where this system keeps gsettings; dconf is in the profile.
settings_set() {
  local schema="$1" key="$2" value="$3" bin
  for bin in "$(command -v gsettings 2>/dev/null || true)" /usr/bin/gsettings /run/current-system/sw/bin/gsettings; do
    if [ -n "$bin" ] && [ -x "$bin" ] && "$bin" set "$schema" "$key" "$value" 2>/dev/null; then
      return 0
    fi
  done
  if command -v dconf >/dev/null 2>&1; then
    dconf write "/${schema//.//}/$key" "'$value'" 2>/dev/null || true
  fi
  return 0
}

# Set (or append) a key in a GTK settings.ini without touching the other keys.
ini_set() {
  local file="$1" key="$2" val="$3"
  mkdir -p "$(dirname "$file")"
  [ -f "$file" ] || printf '[Settings]\n' > "$file"
  grep -qx '\[Settings\]' "$file" || sed -i '1i [Settings]' "$file"
  if grep -q "^${key}=" "$file"; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$file"
  else
    sed -i "/^\[Settings\]/a ${key}=${val}" "$file"
  fi
}

# Push light/dark to the three knobs the desktop actually reads:
#
#   gtk-3.0/settings.ini  GTK3 apps. Adwaita-dark is a real theme here.
#   gtk-4.0/settings.ini  GTK4 apps. There is no Adwaita-dark; the
#                         prefer-dark flag is what switches Adwaita.
#   gsettings color-scheme
#                         xdg-desktop-portal serves this as
#                         org.freedesktop.appearance color-scheme, which is
#                         what Chromium (Helium) and Electron (T3 Code) ask
#                         for prefers-color-scheme, and what libadwaita uses.
#
# Chromium and Electron also watch gtk-theme-name / prefer-dark directly, so
# both paths point the same way. Most apps repaint live; a few need a restart.
apply_gtk_mode() {
  local mode="$1" theme pref scheme
  if [ "$mode" = light ]; then
    theme=Adwaita; pref=0; scheme=prefer-light
  else
    theme=Adwaita-dark; pref=1; scheme=prefer-dark
  fi
  ini_set "$CONFIG/gtk-3.0/settings.ini" gtk-theme-name "$theme"
  ini_set "$CONFIG/gtk-3.0/settings.ini" gtk-application-prefer-dark-theme "$pref"
  ini_set "$CONFIG/gtk-4.0/settings.ini" gtk-theme-name Adwaita
  ini_set "$CONFIG/gtk-4.0/settings.ini" gtk-application-prefer-dark-theme "$pref"
  settings_set org.gnome.desktop.interface color-scheme "$scheme"
  settings_set org.gnome.desktop.interface gtk-theme "$theme"
}

# Hand the rendered palette to apps that cannot include a file from
# ~/.config/matugen/generated. Both only read their copy at startup, so a
# running instance keeps the old palette until it is relaunched.
sync_apps() {
  local profile chrome

  # Zen Browser: userChrome/userContent belong to the profile, not to a shared
  # config path. Firefox also ignores them unless the legacy stylesheet pref is
  # on; user.js is re-applied on every start and never rewritten by the browser.
  for profile in "$CONFIG"/zen/*/; do
    [ -f "${profile}prefs.js" ] || continue
    chrome="${profile}chrome"
    mkdir -p "$chrome"
    cp -f "$GEN_DIR/zen-userChrome.css" "$chrome/userChrome.css" 2>/dev/null || continue
    cp -f "$GEN_DIR/zen-userContent.css" "$chrome/userContent.css" 2>/dev/null || true
    grep -q legacyUserProfileCustomizations "${profile}user.js" 2>/dev/null ||
      printf '%s\n' 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' \
        >> "${profile}user.js"
  done

  # btop: drop the theme in its own theme dir and select it.
  if [ -f "$CONFIG/btop/btop.conf" ]; then
    mkdir -p "$CONFIG/btop/themes"
    cp -f "$GEN_DIR/btop.theme" "$CONFIG/btop/themes/matugen.theme"
    if grep -qE '^[[:space:]]*color_theme[[:space:]]*=' "$CONFIG/btop/btop.conf"; then
      sed -i 's|^[[:space:]]*color_theme[[:space:]]*=.*|color_theme = "matugen"|' "$CONFIG/btop/btop.conf"
    else
      printf 'color_theme = "matugen"\n' >> "$CONFIG/btop/btop.conf"
    fi
  fi
}

# notchD reads this file to pick its palette (and other tools can too).
write_effective_mode() {
  local bg r g b mode
  bg="$(awk '$1 == "background" { print $2; exit }' "$GEN_DIR/kitty-colors.conf" 2>/dev/null || true)"
  mkdir -p "$GEN_DIR"
  if [[ "$bg" =~ ^#[0-9a-fA-F]{6}$ ]]; then
    r=$((16#${bg:1:2})); g=$((16#${bg:3:2})); b=$((16#${bg:5:2}))
    if (( r * 299 + g * 587 + b * 114 > 127000 )); then
      mode=light
    else
      mode=dark
    fi
  elif [ "$(theme_mode)" = light ]; then
    mode=light
  else
    mode=dark
  fi
  echo "$mode" > "$GEN_DIR/mode"
  apply_gtk_mode "$mode"
}

usage() {
  cat <<'EOF'
wp — set wallpaper and regenerate the desktop theme from it.

Usage:
  wp                        random wallpaper from ~/Pictures/walls (recursive)
  wp random                 same
  wp gruvbox                random from walls/gruvbox
  wp bw                     random from walls/bw (black & white / e-ink)
  wp manga                  random from walls/manga
  wp fav                    random from your favorites (alias: wp best)
  wp fav add [path]         favorite a wallpaper (default: the current one)
  wp fav rm [path]          unfavorite a wallpaper (default: the current one)
  wp fav toggle [path]      toggle favorite (default: the current one)
  wp fav list               list favorites
  wp theme                  show the global theme mode
  wp theme auto|light|dark  set global mode and re-theme the current wallpaper
  wp current                print the current wallpaper path, if any
  wp refresh                regenerate the theme from the current wallpaper
  wp <path>                 apply an explicit image
  wp -h | --help | help     show this help

Favorites are stored in ~/.config/wallpapers/favorites.
Theme mode is stored in ~/.config/wallpapers/theme (auto follows wallpaper).
EOF
}

case "${1:-random}" in
  -h|--help|help) usage; exit 0 ;;
  current) current_wall; exit 0 ;;
  random)  wall="$(pick "$WALLS")" ;;
  gruvbox) wall="$(pick "$WALLS/gruvbox")" ;;
  bw)      wall="$(pick "$WALLS/bw")" ;;
  manga)   wall="$(pick "$WALLS/manga")" ;;
  fav|best)
    case "${2:-random}" in
      add)       fav_add "${3:-}"; exit 0 ;;
      rm|remove) fav_rm "${3:-}"; exit 0 ;;
      toggle)    fav_toggle "${3:-}"; exit 0 ;;
      list|ls)   fav_list; exit 0 ;;
    esac
    wall="$(fav_list | shuf -n 1 || true)"
    if [ -z "$wall" ]; then
      echo "wp: no favorites yet — add one with: wp fav add" >&2
      exit 1
    fi
    ;;
  theme)
    case "${2:-show}" in
      light|dark|auto)
        mkdir -p "$(dirname "$THEME_FILE")"
        printf '%s\n' "$2" > "$THEME_FILE"
        echo "wp: theme mode: $2"
        ;;
      show|"")
        theme_mode
        exit 0
        ;;
      *)
        echo "wp: theme must be auto, light or dark" >&2
        exit 1
        ;;
    esac
    cur="$(current_wall)"
    if [ -n "$cur" ] && [ -f "$cur" ]; then
      exec "$0" refresh
    fi
    # No wallpaper to derive from yet: still honour an explicit light/dark.
    case "$2" in
      light|dark) apply_gtk_mode "$2" ;;
    esac
    exit 0
    ;;
  refresh) wall="$(current_wall)" ;;
  *)       wall="$1" ;;
esac

if [ -z "$wall" ] || [ ! -f "$wall" ]; then
  echo "wp: no such wallpaper: ${wall:-<empty>}" >&2
  exit 1
fi

awww img --transition-type center --transition-duration 0.6 "$wall"

case "$wall" in
  "$WALLS/bw/"*) scheme=scheme-monochrome ;;
  *)             scheme=scheme-tonal-spot ;;
esac

# niri has no variables: matugen writes an include file that config.kdl
# pulls in. The directory must exist before matugen writes it.
mkdir -p "$HOME/.config/niri/generated"

matugen image "$wall" --type "$scheme" --mode "$(matugen_mode)"
sync_apps
write_effective_mode
echo "wp: $wall ($scheme, mode $(theme_mode))"
