#!/usr/bin/env bash
# wp-boot — niri startup entry: make sure the awww daemon is up, then set a
# random wallpaper (and regenerate the theme) via `wp`.
set -u

# The daemon is a supervised user service (home/matugen.nix), not a private
# background job, so `systemctl --user restart awww-daemon.service` is enough
# to recover it later. `start` is a no-op when it is already running.
systemctl --user start awww-daemon.service || true

wp_bin="$HOME/.local/bin/wp"

# Wait for the daemon (max ~5s), then theme the session.
for _ in $(seq 1 50); do
  if "$wp_bin" "${1:-random}"; then
    exit 0
  fi
  sleep 0.1
done

echo "wp-boot: awww-daemon did not come up in time" >&2
exit 1
