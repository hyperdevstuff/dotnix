# Seed used only until matugen writes the real ~/.config/kdeglobals.
# `wp` replaces this file from the current wallpaper; the palette here is the
# neutral dark fallback so a fresh session never opens Dolphin with a white
# file view.

[General]
SingleClick=false
font=Inter,10,-1,5,50,0,0,0,0,0
menuFont=Inter,10,-1,5,50,0,0,0,0,0
toolBarFont=Inter,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0

[Icons]
Theme=Papirus-Dark

[KDE]
contrast=4
widgetStyle=Breeze
ShowIconsOnPushButtons=false
ShowIconsInMenuItems=false

# Dolphin / KDE palette. Kept neutral on purpose: the desktop shell is the
# Vercel-style black/white island, so the file manager should be a quiet
# dark-gray surface with a white focus ring rather than a blue accent.
