# KDE color scheme generated from the current wallpaper by matugen.
# Installed as ~/.local/share/color-schemes/Dotnix.colors and referenced from
# dotfiles/kde/kdeglobals (`ColorScheme=Dotnix`).
#
# Dolphin is the only KDE app here. It reads the scheme through
# plasma-integration; modules/nixos/desktop.nix sets KDE_COLOR_SCHEME_PATH so
# Breeze paints item views with the same palette as the rest of the window.
#
# Role choices: surfaces come from the Material surface ramp, text from
# on_surface/on_surface_variant, and the wallpaper accent (primary) is used
# sparingly for focus rings and links. Selection stays a muted container so
# the file list does not read as a block of accent color.

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

