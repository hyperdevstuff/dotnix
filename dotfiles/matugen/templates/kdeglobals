# KDE configuration + color scheme generated from the current wallpaper.
#
# Written straight to ~/.config/kdeglobals because Dolphin's file view reads
# its palette from the color groups here, not from a .colors file named by
# ColorScheme (a scheme lookup requires Plasma's color-scheme machinery and
# otherwise falls back to white in the item view).
#
# Dolphin is the only KDE app here. Fonts, icons and the Breeze widget style
# are intentionally fixed; only the colors move with the wallpaper.

[General]
SingleClick=false
font=Inter,10,-1,5,50,0,0,0,0,0
menuFont=Inter,10,-1,5,50,0,0,0,0,0
toolBarFont=Inter,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0

[Icons]
Theme=Papirus-Dark

[KDE]
contrast=4
widgetStyle=Breeze
ShowIconsOnPushButtons=false
ShowIconsInMenuItems=false

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

