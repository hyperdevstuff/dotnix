// Generated by matugen from the current wallpaper. Do not edit by hand.
// Included by dotfiles/niri/config.kdl; `wp` reloads niri afterwards.
//
// Only colors live here. Geometry (width, shadow, rounding) stays in the
// hand-written config so this file can be regenerated without touching it.
layout {
    background-color "{{colors.surface.default.hex}}"

    border {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline_variant.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }

    tab-indicator {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline_variant.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
