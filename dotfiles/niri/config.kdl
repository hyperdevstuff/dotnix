// dotnix - Niri configuration
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
//
// "Mod" is Super on a TTY and Alt when niri runs as a window.

// Wallpaper-derived colors (primary/outline/error) written by matugen.
// `wp` and `wp-boot` regenerate this file and reload niri. The seed in
// home/matugen.nix guarantees it exists before niri starts.
include "/home/hyper/.config/niri/generated/colors.kdl"

input {
    keyboard {
        xkb {
            layout "us"
            // Swap CapsLock and Escape.
            options "caps:swapescape"
        }
    }

    touchpad {
        tap
        natural-scroll
        // Ignore accidental taps/pointer motion while typing.
        dwt
    }
}

// Hide the pointer while typing and after a couple of seconds of inactivity.
cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 2000
}

// Pinned to 144 Hz — the panel's true max. VRR is enabled below.
output "eDP-1" {
    mode "1920x1080@144.001"
    scale 1.1
    variable-refresh-rate
}

// niri supports VRR via `variable-refresh-rate` — enabled for the panel above.

layout {
    gaps 10

    // Always keep an empty workspace above the first one. This is the "home"
    // place (Mod+0) where the desktop widgets live. It occupies position 1,
    // so the Mod+1..9 binds below target positions 2..10.
    empty-workspace-above-first

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // Open every app full-width. Columns can still be resized/cycled with
    // the presets above; this only changes what new windows start at.
    default-column-width { proportion 1.0; }

    // Minimal look: no focus glow, one hairline border around every window.
    // Colors come from the matugen include above; width/shadows stay here.
    focus-ring {
        off
    }

    border {
      off
    }

    shadow {
        on
        softness 16
        spread 0
        offset x=0 y=3
        color "#00000044"
    }

    // Show tabs only when a column stacks more than one window.
    tab-indicator {
        hide-when-single-tab
        place-within-column
        corner-radius 6
    }
}

// Wallpaper-first theming: wp-boot starts awww-daemon and applies a random
// wall (regenerating kitty/foot/fuzzel via matugen). swaybg stays
// installed as a fallback but is intentionally not spawned.
spawn-at-startup "/home/hyper/.local/bin/wp-boot"

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Motion: springs for workspace/camera motion (smooth with a hint of bounce),
// ease-out for windows. Window open grows from a circle; close is a subtle
// scale + fade. Shaders are from the niri animations docs.
animations {
    workspace-switch {
        spring damping-ratio=0.9 stiffness=550 epsilon=0.0001
    }

    window-open {
        duration-ms 260
        curve "ease-out-expo"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);

                vec2 coords = (coords_geo.xy - vec2(0.5, 0.5)) * size_geo.xy * 2.0;
                coords = coords / length(size_geo.xy);
                float p = niri_clamped_progress;
                if (p * p <= dot(coords, coords))
                    color = vec4(0.0);

                return color;
            }
        "
    }

    window-close {
        duration-ms 170
        curve "ease-out-quad"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = mix(1.0, 0.96, p);
                coords_geo = vec3((coords_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);

                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * (1.0 - p);
            }
        "
    }

    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=550 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.9 stiffness=600 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=650 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.85 stiffness=500 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}

// Lock before logind suspends on lid close (logind HandleLidSwitch=suspend).
// The lock is the native Quickshell lock screen; swaylock remains a fallback.
switch-events {
    lid-close { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "lock"; }
}

// Firefox picture-in-picture should float.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Transient dialogs and pop-ups are regular XDG toplevels, so they need
// window rules, not layer rules. Layer rules only affect layer-shell surfaces
// such as fuzzel and the notchD overlays below.

// Portals draw out-of-process dialogs: file choosers, screencast pickers,
// camera/access prompts and account/sign-in prompts. They are not parented to
// the requesting app, so niri would otherwise tile them as a full column.
window-rule {
    match app-id=r#"^xdg-desktop-portal"#
    open-floating true
}

// NetworkManager's connection editor is launched from the niri binds.
window-rule {
    match app-id=r#"^(nm-connection-editor|org\.gnome\.nm-connection-editor)$"#
    open-floating true
}

// Google/OAuth sign-in pop-ups from browsers and web apps. This is the early
// path: the title is already set when the window maps. niri only applies
// `open-floating` at open time, so late-titled pop-ups are handled by
// dotfiles/bin/niri-float-popups through niri's event stream. The title
// patterns cover Firefox's en-dash form ("Sign in – Google Accounts —
// Mozilla Firefox"), Chromium's hyphen form ("Sign in - Google Accounts -
// Helium"), generic "Sign in to your account" dialogs, and Steam sign-in.
window-rule {
    match title=r#"(?i)^(sign[ -]?in|log[ -]?in|choose an account|authoriz|oauth|steam.{0,4}sign[ -]?in)"#
    open-floating true
}

// Volume control should float instead of joining the tiling layout.
window-rule {
    match app-id="org.pulseaudio.pavucontrol"
    open-floating true
}

// The clipboard picker is a kitty window with --class clipmenu; it should
// float above the layout instead of taking a column. Its size comes from
// kitty's initial_window_width/height overrides in the Mod+V bind.
window-rule {
    match app-id=r#"^clipmenu$"#
    open-floating true
}

// Keep password managers out of screencasts and cast targets. Multiple
// `match` lines in one rule are ORed; here the alternatives share one regex.
window-rule {
    match app-id=r#"^(org\.keepassxc\.KeePassXC|com\.bitwarden\.Bitwarden|com\.onepassword\.1Password|org\.gnome\.World\.Secrets)$"#
    block-out-from "screencast"
}

// Rounded windows that match the hairline border and shadow. This is the
// classic niri setup: niri rounds the border/shadow, then clips the window
// (and its client-side shadows) to the same geometry.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Fuzzel: let niri round the launcher and blur the wallpaper behind it.
// The generated fuzzel background stays slightly translucent so the blur
// is visible.
layer-rule {
    match namespace="fuzzel"
    geometry-corner-radius 14
    background-effect {
        xray true
        blur true
        noise 0.02
        saturation 1.1
    }
}

// Notifications can contain secrets (2FA codes, message previews); keep them
// out of screencasts as well. notchD owns org.freedesktop.Notifications and
// draws the cards on its own layer surface.
layer-rule {
    match namespace="^notchD-notifications$"
    block-out-from "screencast"
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Terminal and launcher.
    Mod+Return hotkey-overlay-title="Open foot" { spawn "foot"; }
    Mod+T hotkey-overlay-title="Open foot" { spawn "foot"; }
    Mod+Q hotkey-overlay-title="Open kitty" { spawn "kitty" "--single-instance"; }
    Mod+B hotkey-overlay-title="Open Helium" { spawn "helium"; }
    Mod+E hotkey-overlay-title="Open Dolphin" { spawn "dolphin"; }
    Mod+D hotkey-overlay-title="Run an application" { spawn "fuzzel"; }
    Mod+Space hotkey-overlay-title="Run an application" { spawn "fuzzel"; }
    Super+Alt+L allow-when-locked=true hotkey-overlay-title="Lock the screen" { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "lock"; }

    // Quickshell NotchD: Mod+N opens the hub and closes it again on the next
    // press (hub, flyout or media). Mod+Shift+N hides the whole island.
    Mod+N hotkey-overlay-title="Toggle NotchD hub" { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "toggleExpanded"; }
    Mod+Shift+N hotkey-overlay-title="Show/hide NotchD" { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "toggle"; }
    Mod+Shift+Space hotkey-overlay-title="Show/hide NotchD" { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "toggle"; }

    // Hex dictation. niri has no working GlobalShortcuts portal, so we bind
    // Hex's own control commands (upstream's recommended Wayland setup).
    // Toggle mode means one press starts, the next stops and transcribes.
    // F10 is the hardware touchpad-toggle key on the LOQ, so paste-last is
    // Ctrl+Alt+V instead.
    Alt+Space hotkey-overlay-title="Hex: dictate" { spawn "hex" "dictation" "toggle"; }
    Ctrl+Alt+V hotkey-overlay-title="Hex: paste last dictation" { spawn "hex" "paste-last"; }
    Ctrl+Alt+C hotkey-overlay-title="Hex: copy last dictation" { spawn "/home/hyper/.local/bin/hexclip"; }
    Mod+Alt+X hotkey-overlay-title="Hex: cancel dictation" { spawn "hex" "dictation" "cancel"; }
    // On Wayland Hex cannot grab Esc only while recording, so every Esc goes
    // through a tiny helper: it cancels a running dictation, otherwise
    // replays Esc to the focused window with wtype.
    Escape { spawn "/home/hyper/.local/bin/hex-escape"; }

    // Volume keys. wpctl is the fast path; the IPC call only adds the notchD
    // OSD, so audio still works if the shell is restarting.
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0; quickshell ipc -c notchD call notchD showVolume"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-; quickshell ipc -c notchD call notchD showVolume"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; quickshell ipc -c notchD call notchD showVolume"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; quickshell ipc -c notchD call notchD showMic"; }

    // Media keys. playerctl keeps working without notchD; the IPC opens the
    // downward now-playing card when it is available.
    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause; quickshell ipc -c notchD call notchD mediaPeek"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause; quickshell ipc -c notchD call notchD mediaPeek"; }
    XF86AudioStop  allow-when-locked=true { spawn-sh "playerctl stop; quickshell ipc -c notchD call notchD mediaPeek"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous; quickshell ipc -c notchD call notchD mediaPeek"; }
    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next; quickshell ipc -c notchD call notchD mediaPeek"; }

    // Brightness keys use brightnessctl for the action and notchD for Feedback.
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set +5%; quickshell ipc -c notchD call notchD showBrightness"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set 5%-; quickshell ipc -c notchD call notchD showBrightness"; }

    // notchD-first shortcuts. External GUIs stay as advanced fallbacks.
    Mod+Shift+B hotkey-overlay-title="Set brightness to 60%" { spawn-sh "brightnessctl set 60%; quickshell ipc -c notchD call notchD showBrightness"; }
    Mod+Shift+A hotkey-overlay-title="Audio controls" { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "openAudio"; }
    Mod+Alt+A hotkey-overlay-title="Advanced audio (pavucontrol)" { spawn "pavucontrol"; }
    Mod+Alt+N hotkey-overlay-title="Wi-Fi controls" { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "openWifi"; }
    Mod+Alt+Shift+N hotkey-overlay-title="Advanced networks (nm-connection-editor)" { spawn "nm-connection-editor"; }
    Mod+Alt+S hotkey-overlay-title="Session and power" { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "openSession"; }
    Mod+Alt+M hotkey-overlay-title="Now playing" { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "openMedia"; }
    Mod+Alt+H hotkey-overlay-title="Toggle home" { spawn "quickshell" "ipc" "-c" "notchD" "call" "notchD" "toggleHome"; }

    // Focus jump and dynamic cast (OBS/browser screen share).
    Mod+G              hotkey-overlay-title="Focus previous window" { focus-window-previous; }
    Mod+Shift+D        hotkey-overlay-title=null { set-dynamic-cast-window; }
    Mod+Ctrl+D         hotkey-overlay-title=null { set-dynamic-cast-monitor; }
    Mod+Ctrl+Shift+D   hotkey-overlay-title=null { clear-dynamic-cast-target; }

    // Overview.
    Mod+O repeat=false { toggle-overview; }

    Mod+C repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }

    // Focus.
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // Move windows within the layout.
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // Monitor focus and movement.
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Workspaces.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }

    Mod+Tab { focus-workspace-previous; }

    // Instant last-window toggle: no switcher UI.
    Mod+grave { focus-window-previous; }

    // Mouse wheel: switch workspaces, or move the focused column.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    // Position 1 is the always-empty home workspace. Normal workspaces start
    // at position 2, so Mod+1..9 still mean the first through ninth normal
    // workspace. Mod+0 jumps to home; Mod+Tab returns to the previous one.
    Mod+0 { focus-workspace 1; }
    Mod+1 { focus-workspace 2; }
    Mod+2 { focus-workspace 3; }
    Mod+3 { focus-workspace 4; }
    Mod+4 { focus-workspace 5; }
    Mod+5 { focus-workspace 6; }
    Mod+6 { focus-workspace 7; }
    Mod+7 { focus-workspace 8; }
    Mod+8 { focus-workspace 9; }
    Mod+9 { focus-workspace 10; }

    // Keep move-to-workspace on the same normal positions as the focus binds.
    Mod+Ctrl+1 { move-column-to-workspace 2; }
    Mod+Ctrl+2 { move-column-to-workspace 3; }
    Mod+Ctrl+3 { move-column-to-workspace 4; }
    Mod+Ctrl+4 { move-column-to-workspace 5; }
    Mod+Ctrl+5 { move-column-to-workspace 6; }
    Mod+Ctrl+6 { move-column-to-workspace 7; }
    Mod+Ctrl+7 { move-column-to-workspace 8; }
    Mod+Ctrl+8 { move-column-to-workspace 9; }
    Mod+Ctrl+9 { move-column-to-workspace 10; }

    // Column management.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }
    Mod+Ctrl+Comma   { swap-window-left; }
    Mod+Ctrl+Period  { swap-window-right; }
    Mod+Ctrl+BracketLeft  { focus-column-left-or-last; }
    Mod+Ctrl+BracketRight { focus-column-right-or-first; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }

    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+Shift+F hotkey-overlay-title="Windowed fullscreen" { toggle-windowed-fullscreen; }
    Mod+M       { maximize-window-to-edges; }
    Mod+Ctrl+F  { expand-column-to-available-width; }

    Mod+Shift+C { center-column; }
    Mod+Ctrl+C  { center-visible-columns; }
    Mod+Shift+M { center-window; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       hotkey-overlay-title="Clipboard history" { spawn "kitty" "--single-instance" "--class" "clipmenu" "-o" "initial_window_width=960" "-o" "initial_window_height=640" "-e" "/home/hyper/.local/bin/clipmenu"; }
    Mod+Alt+V   hotkey-overlay-title="Toggle window floating" { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }

    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }
    Mod+Shift+Print hotkey-overlay-title="Screenshot window to clipboard" { screenshot-window write-to-disk=false; }

    // Mirror the focused output into a window; move it to the target screen
    // and fullscreen it with Mod+Shift+F. Needs wl-mirror + jq.
    Mod+P repeat=false hotkey-overlay-title="Mirror focused output" { spawn-sh "wl-mirror $(niri msg --json focused-output | jq -r .name)"; }

    // Yazi in a fresh kitty window; the old file manager shortcut (Mod+E)
    // still opens Dolphin for GUI work. Quit moved off Mod+Shift+E to
    // Mod+Shift+Q to make room.
    Mod+Shift+E hotkey-overlay-title="Open Yazi" { spawn "kitty" "--single-instance" "--class" "yazi" "-e" "yazi"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+Q { quit; }
    Ctrl+Alt+Delete { quit; }

    Mod+Shift+P { power-off-monitors; }
}
