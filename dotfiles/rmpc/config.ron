#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    password: None,
    // Old gruvbox theme from hyperdevstuff/dotfiles.
    theme: Some("gruvbox"),
    cache_dir: Some("/home/hyper/.cache/rmpc"),
    lyrics_dir: Some("/mnt/library/Music"),
    // Fetches synced lyrics from lrclib on song change (needs curl + jq).
    on_song_change: ["/home/hyper/.config/rmpc/scripts/lrc.sh"],
    volume_step: 5,
    // Lower than the old 60 fps to be easy on the laptop/iGPU.
    max_fps: 30,
    scrolloff: 2,
    wrap_navigation: true,
    enable_mouse: true,
    scroll_amount: 1,
    enable_config_hot_reload: true,
    enable_lyrics_index: false,
    enable_lyrics_hot_reload: false,
    status_update_interval_ms: 1000,
    rewind_to_start_sec: None,
    keep_state_on_song_change: true,
    reflect_changes_to_playlist: false,
    select_current_song_on_change: false,
    browser_song_sort: [Disc, Track, Artist, Title],
    directories_sort: SortFormat(group_by_type: true, reverse: false),
    auto_open_downloads: false,
    album_art: (
        method: Auto,
        max_size_px: (width: 1200, height: 1200),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
    ),
    // Old config had a Cava pane fed by an MPD FIFO (/tmp/mpd.fifo). MPD here
    // only outputs to PipeWire (no FIFO), so Cava is left out to avoid CPU and
    // a broken pane. To restore it, add an MPD fifo output and the cava block.
    keybinds: (
        global: {
            ":":       CommandMode,
            ",":       VolumeDown,
            "s":       Stop,
            ".":       VolumeUp,
            "<Tab>":   NextTab,
            "<S-Tab>": PreviousTab,
            "L":       NextTab,
            "H":       PreviousTab,
            "1":       SwitchToTab("Queue"),
            "2":       SwitchToTab("Directories"),
            "3":       SwitchToTab("Albums"),
            "4":       SwitchToTab("Artists"),
            "5":       SwitchToTab("Playlists"),
            "6":       SwitchToTab("Lyrics"),
            "7":       SwitchToTab("Search"),
            "<C-g>":   SwitchToTab("Search"),
            "q":       Quit,
            ">":       NextTrack,
            "<":       PreviousTrack,
            "p":       TogglePause,
            "<Space>": TogglePause,
            "f":       SeekForward,
            "z":       ToggleRepeat,
            "x":       ToggleRandom,
            "c":       ToggleConsume,
            "m":       ToggleSingle,
            "b":       SeekBack,
            "~":       ShowHelp,
            "?":       ShowHelp,
            "u":       Update,
            "U":       Rescan,
            "I":       ShowCurrentSongInfo,
            "O":       ShowOutputs,
            "R":       AddRandom,
            "<C-p>":   ShowDecoders,
            "<C-a>":   ExternalCommand(command: ["rmpc", "addrandom", "song", "5"], description: "Add 5 Random Songs"),
            "<C-q>":   ExternalCommand(command: ["rmpc", "addrandom", "song", "15"], description: "Add 15 Random Songs"),
            // New: shuffle the whole NTFS library, excluding scores/soundtracks.
            "S":       ExternalCommand(command: ["/home/hyper/.local/bin/music-shuffle"], description: "Shuffle library (scores excluded)"),
        },
        navigation: {
            "k":         Up,
            "j":         Down,
            "h":         Left,
            "l":         Right,
            "<Up>":      Up,
            "<Down>":    Down,
            "<Left>":    Left,
            "<Right>":   Right,
            "<C-k>":     PaneUp,
            "<C-j>":     PaneDown,
            "<C-h>":     PaneLeft,
            "<C-l>":     PaneRight,
            "<C-u>":     UpHalf,
            "N":         PreviousResult,
            "a":         Add,
            "A":         AddAll,
            "r":         Rename,
            "n":         NextResult,
            "g":         Top,
            "v":         Select,
            "<C-Space>": InvertSelection,
            "G":         Bottom,
            "<CR>":      Confirm,
            "i":         FocusInput,
            "J":         MoveDown,
            "<C-d>":     DownHalf,
            "/":         EnterSearch,
            "<C-c>":     Close,
            "<Esc>":     Close,
            "K":         MoveUp,
            "D":         Delete,
            "E":         ShowInfo,
        },
        queue: {
            "D":       DeleteAll,
            "<CR>":    Play,
            "<C-s>":   Save,
            "a":       AddToPlaylist,
            "d":       Delete,
            "C":       JumpToCurrent,
            "X":       Shuffle,
        },
    ),
    search: (
        case_sensitive: false,
        mode: Contains,
        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "artist",      label: "Artist"),
            (value: "album",       label: "Album"),
            (value: "filename",    label: "Filename"),
            (value: "albumartist", label: "Album Artist"),
            (value: "title",       label: "Title"),
        ],
    ),
    artists: (
        album_display_mode: SplitByDate,
        album_sort_by: Date,
    ),
    tabs: [(
            name: "Queue",
            border_type: None,
            pane: Split(
                direction: Horizontal,
                borders: "BOTTOM",
                panes: [
                    (
                        size: "33%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "0.409090909r",
                                    pane: Pane(AlbumArt),
                                ),
                                (
                                    size: "100%",
                                    pane: Pane(Lyrics),
                                ),
                            ],
                        ),
                    ),
                    (
                        size: "100%",
                        pane: Pane(Queue),
                    )
                ],
            ),
        ),
        (name: "Directories",    pane: Pane(Directories), border_type: None ),
        ( name: "Albums",        pane: Pane(Albums),border_type:None ),
        ( name: "Artists",       pane: Pane(Artists),border_type:None ),
        ( name: "Playlists",     pane: Pane(Playlists),border_type:None ),
        (
            name: "Lyrics",
            pane: Split(
                direction: Horizontal,
                borders: "BOTTOM",
                panes: [(size: "100%", pane: Pane(AlbumArt)), (size: "100%", pane: Pane(Lyrics))],
            ),
        ),
        ( name: "Search",        pane: Pane(Search),border_type:None ),
    ],
)
