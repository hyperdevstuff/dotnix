{
  services.mako = {
    enable = true;

    settings = {
      anchor = "top-right";
      default-timeout = 8000;
      width = 360;
      height = 160;
      margin = 10;
      padding = 12;
      border-size = 2;
      border-radius = 10;
      font = "JetBrainsMono Nerd Font 10";
      background-color = "#1e1e2e";
      text-color = "#cdd6f4";
      border-color = "#cba6f7";
      progress-color = "over #89b4fa";
      icons = true;
      max-icon-size = 48;
      layer = "overlay";
      group-by = "app-name";
    };
  };
}
