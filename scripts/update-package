#!/usr/bin/env python3

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
VERSION_PIN = r'^  version = "([^"\n]+)";$'
HASH_PIN = r'^    hash = "([^"\n]+)";$'
HEX_TAG = r'^      url = "github:anomalyco/hex/v([^"\n]+)";$'


def run(*args):
    return subprocess.check_output(args, cwd=ROOT, text=True).strip()


def find_pin(contents, pattern):
    matches = list(re.finditer(pattern, contents, re.MULTILINE))
    if len(matches) != 1:
        raise ValueError(f"Expected one pin matching {pattern}, found {len(matches)}")
    return matches[0]


def replace_pin(contents, pattern, value):
    start, end = find_pin(contents, pattern).span(1)
    return contents[:start] + value + contents[end:]


def release_hash(repo, version, asset_name, existing_hash):
    tag = f"v{version}"
    release = json.loads(run("gh", "api", f"repos/{repo}/releases/tags/{tag}"))
    url = f"https://github.com/{repo}/releases/download/{tag}/{asset_name}"
    assets = [asset for asset in release["assets"] if asset["name"] == asset_name]
    if (
        release["tag_name"] != tag
        or release["draft"]
        or len(assets) != 1
        or assets[0]["browser_download_url"] != url
    ):
        raise ValueError(f"Could not verify the official asset {asset_name} for {repo} {tag}")

    prefetch = ["nix", "store", "prefetch-file", "--json"]
    digest = assets[0].get("digest")
    if digest is not None:
        if not re.fullmatch(r"sha256:[0-9a-fA-F]{64}", digest):
            raise ValueError(f"Unexpected digest format for {asset_name}")
        expected = run(
            "nix", "hash", "convert", "--hash-algo", "sha256", "--to", "sri", digest.removeprefix("sha256:")
        )
        if existing_hash and expected != existing_hash:
            raise ValueError(
                f"Published digest for {repo} {tag} differs from the existing pin. Investigate upstream before accepting it."
            )
        if existing_hash:
            return expected
        prefetch.extend(["--expected-hash", expected])

    downloaded = json.loads(run(*prefetch, url))["hash"]
    if existing_hash and downloaded != existing_hash:
        raise ValueError(
            f"Downloaded asset for {repo} {tag} differs from the existing pin. Investigate upstream before accepting it."
        )
    return downloaded


def update(package, version):
    if package == "hex":
        package_file = Path("pkgs/hex-bin.nix")
        repo = "anomalyco/hex"
        asset = f"hex-{version}-linux-x64.deb"
        files = [package_file, Path("flake.nix"), Path("flake.lock")]
    else:
        package_file = Path("pkgs/t3code-nightly.nix")
        repo = "pingdotgg/t3code"
        asset = "T3-Code-Nightly-x86_64.AppImage"
        files = [package_file]

    original = {file: (ROOT / file).read_text() for file in files}
    contents = original[package_file]
    old_version = find_pin(contents, VERSION_PIN)[1]
    old_hash = find_pin(contents, HASH_PIN)[1]
    asset_hash = release_hash(repo, version, asset, old_hash if old_version == version else None)
    updated = replace_pin(replace_pin(contents, VERSION_PIN, version), HASH_PIN, asset_hash)

    with tempfile.TemporaryDirectory(prefix=".update-package-", dir=ROOT) as directory:
        stage = Path(directory)
        (stage / "pkgs").mkdir()
        (stage / package_file).write_text(updated)
        if package == "hex":
            flake = original[Path("flake.nix")]
            lock = original[Path("flake.lock")]
            lockfile = json.loads(lock)
            nodes = lockfile["nodes"]
            locked_input = nodes[nodes[lockfile["root"]]["inputs"]["hex"]]
            (stage / "flake.nix").write_text(replace_pin(flake, HEX_TAG, version))
            (stage / "flake.lock").write_text(lock)
            if (
                find_pin(flake, HEX_TAG)[1] != version
                or locked_input["original"].get("ref") != f"v{version}"
            ):
                # Resolve the new tag before changing any files in the checkout.
                run("nix", "flake", "update", "hex", "--flake", f"path:{stage}")

        if any((ROOT / file).read_text() != original[file] for file in files):
            raise ValueError("Package files changed during the update. Review your edits and retry.")

        changed = [file for file in files if (stage / file).read_text() != original[file]]
        for file in changed:
            (stage / file).chmod((ROOT / file).stat().st_mode & 0o777)
        published = []
        try:
            for file in changed:
                (stage / file).replace(ROOT / file)
                published.append(file)
        except (OSError, KeyboardInterrupt):
            for file in reversed(published):
                (stage / file).write_text(original[file])
                (stage / file).replace(ROOT / file)
            raise

    if changed:
        print(f"Updated {package} to {version}. Review {', '.join(map(str, changed))}.")
    else:
        print(f"{package} {version} is already pinned.")


def main():
    parser = argparse.ArgumentParser(description="Update a package from an official GitHub release.")
    parser.add_argument("package", choices=("hex", "t3code-nightly"))
    parser.add_argument("--version", required=True, help="release version, optionally prefixed with v")
    args = parser.parse_args()
    version = args.version.removeprefix("v")
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9][A-Za-z0-9.-]*)?", version):
        parser.error("provide an exact release version such as 3.4.0 or 0.1.12-nightly.20261122.5071")

    fd = os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        update(args.package, version)
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f"update-package: {error}", file=sys.stderr)
        return 1
    finally:
        os.close(fd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
